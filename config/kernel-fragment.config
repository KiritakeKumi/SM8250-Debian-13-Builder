# Kernel config fragment for nico-debian-sm8250 (QRB5165 / SM8250)
#
# Merged on top of config/kernel-base.config by scripts/build-kernel.sh.
# Keep this file small: only the deltas that actually matter for this board.

## --- Platform / SoC -------------------------------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_ARM64=y
CONFIG_ARM64_VA_BITS_48=y

## --- Storage: UFS (rootfs lives here) ------------------------------------
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP=y

## --- PCIe controllers -----------------------------------------------------
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y
CONFIG_PCIE_QCOM=y
CONFIG_PCIE_DW=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PCI_MSI=y

## --- PCIe PHY -------------------------------------------------------------
# The in-tree QMP PCIe PHY is kept enabled so pcie0 (QCA6390 wifi) works out of
# the box. If you also ship the out-of-tree PHY replacement, the module loader
# takes precedence for the board port only.
CONFIG_PHY_QCOM_QMP_PCIE=y

## --- Networking -----------------------------------------------------------
CONFIG_R8169=m
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

## --- IOMMU ----------------------------------------------------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y

## --- USB (the board exposes USB2/USB3 + the recovery ADB gadget) ----------
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

## --- Serial console (ttyMSM0 @ 0xa90000) ---------------------------------
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

## --- Regulators / clocks / pinctrl ---------------------------------------
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_PINCTRL_SM8250=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_QCOM_GDSC=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8250=y

## --- Thermal / ADC --------------------------------------------------------
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

## --- Filesystems / init ---------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

## --- Modules --------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_NONE=y
# no out-of-tree module version checking headaches
# CONFIG_MODVERSIONS is not set
CONFIG_MODULE_SIG=n
CONFIG_LOCALVERSION_AUTO=n

## --- Misc -----------------------------------------------------------------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
