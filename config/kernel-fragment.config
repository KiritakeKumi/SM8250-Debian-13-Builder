# Kernel config fragment — merged on top of config/kernel-base.config.
#
# IMPORTANT: config/kernel-base.config is a COMPLETE arm64 defconfig (the one
# the board actually runs, dumped from /proc/config.gz on a working unit).
# It already contains everything needed for this SoC, so this fragment only
# carries the deltas we deliberately want.
#
# Do NOT replace kernel-base.config with an Armbian
# `config/kernel/linux-sm8250-*.config` file: those are ~1000-line *fragments*
# with no CONFIG_ARM64 / arch sections, and `make olddefconfig` on them
# produces a broken .config that fails to build.

## --- kernel release string ------------------------------------------------
# Keep the release plain ("6.18.35") so the module vermagic matches what the
# packaging expects. The board's working build uses an empty LOCALVERSION too.
CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=n

## --- loadable modules -----------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SIG=n
# the board's working kernel ships uncompressed modules; the modern Kconfig
# expresses this as MODULE_COMPRESS=n (there is no _NONE symbol)
CONFIG_MODULE_COMPRESS=n

## --- initramfs / early boot ----------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_RD_GZIP=y

## --- SoC / storage (already =y in base; restated so the intent is explicit)
CONFIG_ARCH_QCOM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

## --- PCIe ----------------------------------------------------------------
CONFIG_PCIE_QCOM=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
# The in-tree QMP PCIe PHY must stay enabled: pcie0 (QCA6390 wifi) and pcie1
# (the ASM2806 switch) both use it.
CONFIG_PHY_QCOM_QMP_PCIE=y
# Realtek NIC driver for the two RTL8168 behind the ASM2806 switch.
CONFIG_R8169=m

## --- IOMMU ---------------------------------------------------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y

## --- console -------------------------------------------------------------
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

## --- filesystems ---------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
