# Shell scripts and YAML must keep LF on every platform, otherwise the scripts
# break on Linux runners.
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.config        text eol=lf
*.txt           text eol=lf
*.dts           text eol=lf
*.dtsi          text eol=lf
Makefile        text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# C sources: LF too (kernel style)
*.c             text eol=lf
*.h             text eol=lf

# Markdown: LF
*.md            text eol=lf

# License text: LF
LICENSE         text eol=lf

# Anything binary should never be normalised
*.img           binary
*.dtb           binary
*.gz            binary
*.xz            binary
*.deb           binary
